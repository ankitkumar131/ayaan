# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/ecommerce-clothing
DB_NAME=ecommerce-clothing

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRE=24h
JWT_ADMIN_EXPIRE=4h

# Admin Configuration
ADMIN_REGISTRATION_KEY=admin_secret_key_2024
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@ecommerce.com
DEFAULT_ADMIN_PASSWORD=Admin@123456

# Email Configuration
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM=noreply@ecommerce.com

# Frontend Configuration
FRONTEND_URL=http://localhost:4200
CORS_ORIGIN=http://localhost:4200

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads
ALLOWED_FILE_TYPES=jpg,jpeg,png,webp

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_ADMIN_MAX=1000

# Security
BCRYPT_SALT_ROUNDS=12
SESSION_SECRET=your_session_secret_here

# Payment Configuration (for future use)
STRIPE_SECRET_KEY=sk_test_your_stripe_key
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# Advanced Services Configuration
ELASTICSEARCH_URL=http://localhost:9200
REDIS_URL=redis://localhost:6379

# Logging Configuration
LOG_LEVEL=info

# Analytics Configuration
ANALYTICS_TRACKING_ID=GA_TRACKING_ID

# Cache Configuration
CACHE_TTL_DEFAULT=300
CACHE_TTL_PRODUCTS=600
CACHE_TTL_CATEGORIES=1800
CACHE_TTL_ANALYTICS=900

# Search Configuration
SEARCH_RESULTS_LIMIT=50
SEARCH_SUGGESTIONS_LIMIT=10

# Recommendation Configuration
RECOMMENDATION_LIMIT=20
TRENDING_DAYS=7